# Required: your NVIDIA build.nvidia.com API key
NVIDIA_API_KEY=

# Optional: if set, /api/check-safety requires this value in the
# x-api-key header. Leave unset for an open public demo.
# NOTE: if you set this AND want your own frontend (this repo's UI)
# to keep working, you must also expose it to the client, which means
# it is NOT a real secret at that point — see README "Known limitations".
APP_API_KEY=
